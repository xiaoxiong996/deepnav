# Optional: the initial administrator password (8-128 characters).
# Only read when /data/config.json does not exist yet. Leave it empty to use the
# built-in default (admin / DeepNav@2026) and change it inside the console.
ADMIN_PASSWORD=

# Host loopback port used by the reverse proxy. The container listens on 8090.
APP_PORT=3335

TZ=Asia/Shanghai

# Set to true only when the site is served over HTTPS (directly or via a
# reverse proxy), otherwise login cookies would be rejected by the browser.
COOKIE_SECURE=false

# Set to true when running behind a trusted reverse proxy so client IPs are
# read from X-Forwarded-For / X-Real-IP for login and ping rate limiting.
TRUST_PROXY=false

# HSTS is only sent over HTTPS. includeSubDomains is on by default; set it to
# false if any subdomain of this host must keep serving plain HTTP.
# HSTS_INCLUDE_SUBDOMAINS=true
